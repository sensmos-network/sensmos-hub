# Wallet address from the Sensmos app (Wallet screen). The hub is registered to this wallet.
HUB_OWNER=0x0000000000000000000000000000000000000000
# Six digits the app asks for when pairing. Leave empty to get a random PIN (printed in the log, kept in data/pin.txt).
HUB_PIN=
# LAN port for the app (pairing). The app talks to port 80, like to an ESP32 node; change only if 80 is taken on this host.
HUB_PORT=80
# Home Assistant sensors (read-only, stays on your LAN). URL of your HA and a long-lived access token
# (HA → your profile → Security → Long-lived access tokens). Leave empty to run without sensors.
# The Home Assistant add-on does not need these: it uses the built-in Supervisor API.
HUB_HA_URL=
HUB_HA_TOKEN=
# LoRa sensors (from 0.2.0-beta2): the key phrase set in your sensors. Optional, the app can set it too (hub card → LoRa).
# With HUB_HA_URL/HUB_HA_TOKEN the hub writes their readings to HA as sensor.sensmos_lora_*; HUB_LORA_HA=0 turns that off.
HUB_LORA_KEY=
